<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Status Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LUDO CONTROLLER"
                android:textColor="#F9FAFB"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EF4444"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="DISCONNECTED"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Connection Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#151E31"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etGameIp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="2"
                        android:background="#263349"
                        android:hint="Game IP (e.g. 192.168.1.5)"
                        android:inputType="textUri"
                        android:padding="8dp"
                        android:text="127.0.0.1"
                        android:textColor="#F9FAFB"
                        android:textColorHint="#8794AB"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etPort"
                        android:layout_width="65dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="#263349"
                        android:hint="Port"
                        android:inputType="number"
                        android:padding="8dp"
                        android:text="8080"
                        android:textColor="#F9FAFB"
                        android:textColorHint="#8794AB"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etPin"
                        android:layout_width="65dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="#263349"
                        android:hint="PIN (opt)"
                        android:inputType="number"
                        android:padding="8dp"
                        android:textColor="#F9FAFB"
                        android:textColorHint="#8794AB"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAutoConnect"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#10B981"
                    android:text="⚡  AUTO CONNECT — SAME WI-FI / THIS PHONE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="#3B82F6"
                        android:text="MANUAL CONNECT"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDisconnect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#4B5563"
                        android:text="DISCONNECT"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#7C3AED"
                    android:text="FLOATING OVERLAY (ONE PHONE)"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Live Game State Banner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#151E31"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT PLAYER"
                        android:textColor="#8794AB"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentPlayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#EF4444"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAST DICE"
                        android:textColor="#8794AB"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#F59E0B"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFixedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="#10B981"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="FIXED: 6"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FIXED DICE section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIXED DICE — PICK A NUMBER, THAT NUMBER WILL COME EVERY TIME"
            android:textColor="#FCD34D"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnDice1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#334155"
                android:text="1"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDice2"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#334155"
                android:text="2"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDice3"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#334155"
                android:text="3"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDice4"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="4"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDice5"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="5"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDice6"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="6"
                android:textColor="#CBD5E1"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRollDice"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#10B981"
            android:text="ROLL DICE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Piece Selection & Move Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIECE SELECTION &amp; MOVE"
            android:textColor="#8794AB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPiece1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#7F1D1D"
                android:text="RED"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPiece2"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#14532D"
                android:text="GREEN"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPiece3"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#78350F"
                android:text="YELLOW"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPiece4"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#1E3A8A"
                android:text="BLUE"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMoveSelectedPiece"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#3B82F6"
            android:text="MOVE SELECTED PIECE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Live Game Control Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME ACTIONS"
            android:textColor="#8794AB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4B5563"
                android:text="PAUSE"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4B5563"
                android:text="RESUME"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4B5563"
                android:text="SKIP TURN"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#DC2626"
                android:text="RESET"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Smart Features: AUTO-MOVE + banner hide -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART FEATURES"
            android:textColor="#8794AB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnAutoMove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#334155"
                android:text="AUTO-MOVE: OFF"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBannerToggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#334155"
                android:text="GAME BANNER: SHOWN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-Time Event Console -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT CONSOLE"
            android:textColor="#8794AB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="#060B16"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:text="[CTRL] AUTO CONNECT finds the game by itself — no PIN needed.\n"
            android:textColor="#34D399"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
